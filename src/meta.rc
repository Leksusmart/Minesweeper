#include <windows.h>

#define VER_FILEVERSION 3, 4, 6, 0
#define VER_FILEVERSION_STR "3.4.6.0\0"
#define VER_PRODUCTVERSION 3, 4, 6
#define VER_PRODUCTVERSION_STR "3.4.6\0"

1 VERSIONINFO
FILEVERSION VER_FILEVERSION
PRODUCTVERSION VER_PRODUCTVERSION
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN BLOCK "StringFileInfo"
   BEGIN BLOCK "040904b0"
      BEGIN VALUE "LegalCopyright", "2025 Leksusmart"
      VALUE "CompanyName", "Leksusmart"
      VALUE "FileDescription", "The exe file for the Minesweeper game"
      VALUE "FileVersion", VER_FILEVERSION_STR
      VALUE "ProductVersion", VER_PRODUCTVERSION_STR
      VALUE "InternalName", "Minesweeper"
      VALUE "OriginalFilename", "Minesweeper.exe"
   END
END
BLOCK "VarFileInfo"
   BEGIN
   VALUE "Translation", 0x419, 1200
   END
END

IDI_ICON1 ICON "src/Pictures/Icon.ico"
